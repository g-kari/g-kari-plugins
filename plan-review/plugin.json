  "author": {
    "name": "g-kari"
  },
  "repository": "https://github.com/g-kari/g-kari-plugins",
  "license": "MIT",
  "keywords": [
    "plan-review",
    "copilot",
    "github",
    "plan",
    "design",
    "architecture",
    "feasibility"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "plan-review",
        "shortDescription": "plan-review",
        "longDescription": "GitHub Copilot CLIを使って実装計画・設計ドキュメントを観点別に並列レビューするプラグイン。プランファイルや設計書を複数の専門サブエージェントがcopilot -pで同時にレビューする。",
        "developerName": "g-kari",
        "category": "Developer Tools"
      },
      "hooks": []
    }
  }
}
