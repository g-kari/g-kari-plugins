{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "security-audit",
  "version": "1.0.0",
  "description": "Cloudflare のソース主導セキュリティ監査。通常は関連ガイダンス、明示されたコードベース監査・包括的レビュー・報告成果物の依頼では六段階の検証と報告を実行する。",
  "author": {
    "name": "Cloudflare, Inc."
  },
  "homepage": "https://github.com/cloudflare/security-audit-skill",
  "repository": "https://github.com/g-kari/g-kari-plugins",
  "license": "MIT",
  "keywords": [
    "security",
    "audit",
    "vulnerabilities",
    "cloudflare",
    "codex",
    "claude-code"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "security-audit",
        "shortDescription": "security-audit",
        "longDescription": "Cloudflare のソース主導セキュリティ監査。通常は関連ガイダンス、明示されたコードベース監査・包括的レビュー・報告成果物の依頼では六段階の検証と報告を実行する。",
        "developerName": "Cloudflare, Inc.",
        "category": "Developer Tools"
      },
      "hooks": []
    }
  }
}
